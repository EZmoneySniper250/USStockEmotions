# Copy to .env (git-ignored). Local-dev values only.
S3_ACCESS_KEY=usse-local
S3_SECRET_KEY=usse-local-secret

# Root of the lake. Real tables: s3a://usse-lake ; CI/test runs: s3a://usse-ci
USSE_LAKE_ROOT=s3a://usse-lake
# Schema prefix. "" for real tables (brz/slv/gld); "ci_" for CI (ci_brz/ci_slv/ci_gld)
USSE_SCHEMA_PREFIX=

ANTHROPIC_API_KEY=
